<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Every permission here is granted at install, with no prompt.

      USE_EXACT_ALARM: Play Store policy restricts it to alarm/calendar apps,
      but this is sideloaded and personal, so there is no "Alarms & reminders"
      onboarding flow to write.

      FOREGROUND_SERVICE(_SPECIAL_USE): Android 17 ignores volume changes from
      an app in the background unless it runs a foreground service; see
      VolumeChangeService.

      No ACCESS_NOTIFICATION_POLICY: ring and notification levels are clamped to
      a minimum of 1, so the app never triggers a silent/vibrate transition.
      No POST_NOTIFICATIONS either: the service works without it, and its
      notification is deferred and normally never shown anyway.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      directBootAware is set per receiver below, deliberately not here. At the
      application level it would also cover the activity, the widget receiver,
      and library components (androidx.startup, which initialises WorkManager
      for Glance), none of which can run before first unlock because their
      data is in credential-encrypted storage.
    -->
    <application
        android:name=".VolSchedApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.VolSched">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VolSched">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fired by AlarmManager. Internal only. -->
        <receiver
            android:name=".scheduler.AlarmReceiver"
            android:exported="false"
            android:directBootAware="true" />

        <!--
          Does the actual volume changes for the receivers and the widget.
          Direct-boot aware because the boot receiver starts it before first
          unlock. specialUse because none of the typed services fit, and
          several of them (mediaPlayback included) may not be started from a
          BOOT_COMPLETED receiver on API 35+.
        -->
        <service
            android:name=".scheduler.VolumeChangeService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Applies scheduled volume changes. Android 17 ignores volume changes from apps without a foreground service." />
        </service>

        <!--
          Exported because every action here is a protected system broadcast.

          LOCKED_BOOT_COMPLETED is the important one: plain BOOT_COMPLETED does
          not arrive until first unlock, so an overnight reboot would otherwise
          swallow every event until the phone is picked up.

          MY_PACKAGE_REPLACED matters during development - each sideload wipes
          pending alarms.
        -->
        <receiver
            android:name=".scheduler.BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.VolumeWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/volume_widget_info" />
        </receiver>

    </application>
</manifest>
